          "name": "Calculated Strike",
          "skillSlot": "slot-1",
          "variantPriority": 0,
          "skillType": "attack",
          "basePower": 8,
          "coinPower": 3,
          "coinCount": 2,
          "damageType": "slash",
          "sinType": "sloth",
          "offenseLevel": 0,
          "effects": [
            {
              "trigger": "onSelect",
