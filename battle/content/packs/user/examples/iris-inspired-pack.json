  ],
  "battles": [
    {
      "id": "iris-inspired-smoke",
      "name": "Iris-Inspired Smoke Test",
      "description": "Deploy Iris (Inspired) from a team preset against Dongbaek to playtest the homebrew kit.",
      "enemyUnitIds": [
        "dongbaek"
      ],
      "rules": {
        "encounterType": "focused",
        "maxTurns": 20,
        "victoryCondition": "defeat-all-enemies",
        "failureCondition": "all-allies-defeated",
        "enemyAiProfile": {
          "skill": "first",
          "target": "firstLiving"
        }
      }
    }
  ]
}
