              "operation": "add",
              "value": 0.2
            },
            {
              "trigger": "onHit",
              "type": "applyStatus",
              "statusId": "executioners-mark",
              "count": 2,
              "coinIndex": 2
            },
            {
              "trigger": "onHit",
              "type": "queueStatus",
              "statusId": "paralysis",
              "count": 1,
              "coinIndex": 2
            }
          ],
          "description": "Skill 1 variant when Insight Count is 3+. Execute bonus vs low-HP foes; applies Mark and Paralysis."
        },
        {
          "id": "bleeding-cut",
          "name": "Bleeding Cut",
          "skillType": "attack",
          "basePower": 10,
          "coinPower": 4,
          "coinCount": 3,
          "damageType": "slash",
          "sinType": "gluttony",
          "offenseLevel": 0,
          "effects": [
            {
              "trigger": "onHit",
              "type": "applyStatus",
              "statusId": "bleed",
              "potency": 5,
              "count": 2,
              "coinIndex": 1
            },
            {
              "trigger": "onHit",
              "type": "applyStatus",
              "target": "self",
              "statusId": "poise",
              "count": 1,
              "coinIndex": 3
            },
            {
              "trigger": "onClashWin",
              "type": "applyStatus",
              "target": "self",
              "statusId": "fragile",
              "count": 1
            }
          ],
          "description": "Skill 2. Bleed chain with Poise on the final coin and Fragile on clash win."
