{
  "manifest": {
    "id": "example-iris-inspired-pack",
    "name": "Iris-Inspired Example Pack",
    "version": "1.0.0",
    "engineVersion": "dev",
    "authors": [
      "Echoes of the City"
    ],
    "description": "A simplified Iris-style homebrew kit: Insight and Executioner's Mark statuses, bleed/poise variant skills, guard/counter, and resonance-gated passives.",
    "dependencies": [],
    "featureFlags": {}
  },
  "statuses": [
    {
      "id": "iris-insight",
      "label": "Iris's Insight",
      "description": "For this turn: Attack skills gain +1 Final Power per Count. Expires at Turn End.",
      "countOnly": true,
      "stackModel": {
        "count": {
          "enabled": true,
          "min": 0,
          "max": 10,
          "application": "add"
        },
        "expireWhen": {
          "countLte": 0
        }
      },
      "hooks": {
        "skillSelected": [
          {
            "conditions": [
              {
                "type": "skillType",
                "value": "attack"
              }
            ],
            "actions": [
              {
                "type": "modifyContext",
                "target": "self",
                "field": "flatPowerBonus",
                "operation": "addStatusCountScaled",
                "statusId": "iris-insight",
                "multiplier": 1
              }
            ]
          }
        ],
        "turnEnd": [
          {
            "actions": [
              {
                "type": "consumeStatus",
                "target": "self",
                "statusId": "iris-insight"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "executioners-mark",
      "label": "Executioner's Mark",
      "description": "Bleed skills deal +2 Final Power per Mark Count on the target.",
      "countOnly": true,
      "stackModel": {
        "count": {
          "enabled": true,
          "min": 0,
          "max": 10,
          "application": "add"
        },
        "expireWhen": {
          "countLte": 0
        }
      },
      "hooks": {}
    }
  ],
  "units": [
    {
      "id": "iris-inspired",
      "name": "Iris (Inspired)",
      "level": 45,
      "maxHp": 280,
      "sp": 0,
      "speedRange": [
        3,
        6
      ],
      "defenseLevel": 40,
      "staggerThresholds": [
        0.66,
        0.33
      ],
      "resistances": {
        "physical": {
          "slash": 1,
          "pierce": 1,
          "blunt": 1
        },
        "sin": {
          "wrath": 1,
          "lust": 1,
          "sloth": 0.75,
          "gluttony": 1,
          "gloom": 1,
          "pride": 1,
          "envy": 1
        }
      },
      "passives": [
        {
          "id": "iris-owned-insight",
          "name": "Keen Eye",
          "description": "Owned passive: gain 1 Iris's Insight Count at battle start.",
          "requirements": {
            "owned": true
          },
          "hooks": {
            "battleStart": [
              {
                "type": "applyStatus",
                "target": "self",
                "statusId": "iris-insight",
                "count": 1
              }
            ]
          }
        },
        {
          "id": "iris-resonance-sloth",
          "name": "Sloth Resonance",
          "description": "With 3+ Sloth Resonance, gain 1 Poise Count at turn start.",
          "requirements": {
            "resonance": {
              "sinType": "sloth",
              "minimum": 3
            }
          },
          "hooks": {
            "turnStart": [
              {
                "type": "applyStatus",
                "target": "self",
                "statusId": "poise",
                "count": 1
              }
            ]
          }
        }
      ],
      "sprites": {
        "idle": "assets/debugsprites/Vergilius_Idle_Sprite.png",
        "moving": "assets/debugsprites/Vergilius_Moving_Sprite.png",
        "hurt": "assets/debugsprites/Vergilius_Hurt_Sprite.png",
        "guard": "assets/debugsprites/Vergilius_Guard_Sprite.png",
        "skills": {
          "calculated-strike": "assets/debugsprites/Vergilius_Skill_1.gif",
          "executioners-mercy": "assets/debugsprites/Vergilius_Skill_2.gif",
          "bleeding-cut": "assets/debugsprites/Vergilius_Skill_2.gif",
          "iris-guard": "assets/debugsprites/Vergilius_Skill_3.gif",
          "iris-counter": "assets/debugsprites/Vergilius_Skill_3.gif"
        }
      },
      "skills": [
        {
